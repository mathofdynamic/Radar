{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "radar-pipeline",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "c5d6cf110905c91fc3eed1abaf8236a2",
  "vars": {
    "ENVIRONMENT": "production",
    "RADAR_DESTINATION_CHAT_ID": "-1004496469105",
    "RADAR_DESTINATION_URL": "https://t.me/RadarKhabarOnline",
    "PUBLISH_ENABLED": "false",
    "POLL_BATCH_SIZE": "3",
    "POLL_INTERVAL_SECONDS": "180",
    "MAX_HTML_BYTES": "524288",
    "AI_EMBEDDING_MODEL": "@cf/baai/bge-m3",
    "AI_TEXT_MODEL": "@cf/meta/llama-3.1-8b-instruct-fast",
    "AI_IMAGE_MODEL": "@cf/black-forest-labs/flux-2-klein-4b",
    "AI_DAILY_NEURON_BUDGET": "8000",
    "MAX_EMBEDDINGS_PER_DAY": "1500",
    "MAX_STAGE1_CALLS_PER_DAY": "250",
    "MAX_STAGE2_CALLS_PER_DAY": "40",
    "MAX_COVERS_PER_DAY": "10",
    "EDITORIAL_MIN_SCORE": "78",
    "BREAKING_SCORE": "90",
    "DAILY_STORY_BUDGET": "15",
    "BUSY_DAY_STORY_BUDGET": "25"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "radar-db",
      "database_id": "b83261a2-1b43-4354-8b23-118731e70d86",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [
      { "binding": "POLL_QUEUE", "queue": "radar-poll" },
      { "binding": "RAW_INGEST_QUEUE", "queue": "radar-raw-ingest" },
      { "binding": "EVENT_ANALYSIS_QUEUE", "queue": "radar-event-analysis" },
      { "binding": "EDITORIAL_QUEUE", "queue": "radar-editorial" },
      { "binding": "PUBLISH_QUEUE", "queue": "radar-publish" },
      { "binding": "DEAD_LETTER_QUEUE", "queue": "radar-dead-letter" }
    ],
    "consumers": [
      {
        "queue": "radar-poll",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 3,
        "dead_letter_queue": "radar-dead-letter",
        "max_concurrency": 1
      },
      {
        "queue": "radar-raw-ingest",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 3,
        "dead_letter_queue": "radar-dead-letter"
      },
      {
        "queue": "radar-event-analysis",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 3,
        "dead_letter_queue": "radar-dead-letter",
        "max_concurrency": 2
      },
      {
        "queue": "radar-editorial",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 3,
        "dead_letter_queue": "radar-dead-letter",
        "max_concurrency": 2
      },
      {
        "queue": "radar-publish",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 3,
        "dead_letter_queue": "radar-dead-letter",
        "max_concurrency": 1
      }
    ]
  },
  "ai": { "binding": "AI" },
  "vectorize": [
    { "binding": "EVENT_INDEX", "index_name": "radar-events" }
  ],
  "triggers": {
    "crons": ["*/2 * * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
